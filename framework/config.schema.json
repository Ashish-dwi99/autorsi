{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weight-space-lab:experiment-config:1",
  "title": "Weight Space Lab experiment configuration",
  "description": "Declarative configuration, not execution approval or proof that a model, recipe, or task is supported. Runtime contracts additionally reject duplicate JSON keys, nonfinite numbers, duplicate metric names, invalid endpoint host/port syntax, and excessive recipe nesting. Registered adapters must establish architecture compatibility, artifact provenance, provider availability, actual resource limits, and evaluator trust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goal", "editor", "target", "recipe", "evaluator", "budget"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "goal": {"$ref": "#/$defs/goal"},
    "editor": {"$ref": "#/$defs/editor"},
    "target": {"$ref": "#/$defs/target"},
    "recipe": {"$ref": "#/$defs/recipe"},
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$", "not": {"pattern": "\\s"}
    },
    "optionalIdentifier": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "editor": {
      "description": "The provider/model proposing edits. It is independent from the target model. A provider/model name does not assert public API availability. Credentials remain external.",
      "type": "object", "additionalProperties": false, "required": ["provider", "model"],
      "properties": {
        "provider": {"$ref": "#/$defs/identifier"},
        "model": {"$ref": "#/$defs/identifier"},
        "endpoint": {
          "description": "Optional HTTP(S) endpoint without embedded credentials, query parameters, fragments, or whitespace. Runtime parses its host and port; no network request is made during validation.",
          "oneOf": [
            {"type": "null"},
            {"type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s@?#/]+(?:/[^\\s?#]*)?$"}
          ], "default": null
        },
        "credential_env": {
          "description": "Environment-variable name only; never a credential value.",
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "\\s"}}],
          "default": null
        }
      }
    },
    "target": {
      "description": "The independently identified artifact whose weights may be edited by its compatible registered adapter.",
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "model_id", "architecture", "revision", "artifact_pins"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "architecture": {"$ref": "#/$defs/identifier"},
        "revision": {"$ref": "#/$defs/identifier"},
        "artifact_pins": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "recipe": {
      "type": "object", "additionalProperties": false, "required": ["recipe_id", "parameters"],
      "properties": {
        "recipe_id": {"$ref": "#/$defs/identifier"},
        "parameters": {
          "description": "JSON-only values. The registered recipe enforces its architecture-specific parameter schema. Strings are data and must not be evaluated as code.",
          "type": "object"
        }
      }
    },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluator_id", "suite_id", "suite_revision"],
      "properties": {
        "evaluator_id": {"$ref": "#/$defs/identifier"},
        "suite_id": {"$ref": "#/$defs/identifier"},
        "suite_revision": {"$ref": "#/$defs/identifier"}
      }
    },
    "budget": {
      "description": "Independent editor and target spending ceilings. Unknown actual usage retains the operation reservation. A local budget is not a provider billing cap or a guarantee of physical cancellation.",
      "type": "object", "additionalProperties": false,
      "required": ["max_candidates", "max_evaluations", "max_editor_cost_usd", "max_target_cost_usd", "max_wall_seconds", "max_model_calls"],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_evaluations": {"type": "integer", "minimum": 1},
        "max_editor_cost_usd": {"type": "number", "minimum": 0},
        "max_target_cost_usd": {"type": "number", "minimum": 0},
        "max_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_model_calls": {"type": "integer", "minimum": 0}
      }
    },
    "threshold": {
      "type": "object", "additionalProperties": false, "required": ["value", "comparator"],
      "properties": {
        "value": {"type": "number"},
        "comparator": {"enum": [">=", "<=", ">", "<"]},
        "relative_to": {"$ref": "#/$defs/optionalIdentifier", "default": null}
      },
      "allOf": [{
        "if": {"required": ["relative_to"], "properties": {"relative_to": {"type": "string"}}},
        "then": {"properties": {"value": {"minimum": 0}}}
      }],
      "description": "Without relative_to, compare the measured metric. With relative_to, compare candidate/reference ratio; both must be measured on the same evaluator and suite revision, the reference must be positive, and the candidate must be nonnegative. Missing reference evidence never passes."
    },
    "regression": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "reference": {"$ref": "#/$defs/identifier", "default": "baseline"},
        "tolerance": {"type": "number", "minimum": 0, "default": 0},
        "mode": {"enum": ["absolute", "relative"], "default": "absolute"}
      },
      "description": "Allow at most tolerance degradation from a measured reference. Absolute tolerance uses metric units; relative tolerance uses abs(reference)*tolerance. Maximize imposes a floor; minimize imposes a ceiling."
    },
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["name", "direction", "unit"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "direction": {"enum": ["maximize", "minimize"]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "target": {"oneOf": [{"$ref": "#/$defs/threshold"}, {"type": "null"}], "default": null},
        "regression": {"oneOf": [{"$ref": "#/$defs/regression"}, {"type": "null"}], "default": null}
      },
      "anyOf": [
        {"required": ["target"], "properties": {"target": {"type": "object"}}},
        {"required": ["regression"], "properties": {"regression": {"type": "object"}}}
      ],
      "allOf": [
        {
          "if": {"properties": {"direction": {"const": "maximize"}}},
          "then": {"properties": {"target": {"properties": {"comparator": {"enum": [">=", ">"]}}}}}
        },
        {
          "if": {"properties": {"direction": {"const": "minimize"}}},
          "then": {"properties": {"target": {"properties": {"comparator": {"enum": ["<=", "<"]}}}}}
        }
      ]
    },
    "goal": {
      "description": "Domain and capability labels select compatible evaluators; labels alone do not prove support or success. Every named metric must be returned by the trusted evaluator and all targets and retention guards must pass.",
      "type": "object", "additionalProperties": false,
      "required": ["goal_id", "domain", "capability", "metrics"],
      "properties": {
        "goal_id": {"$ref": "#/$defs/identifier"},
        "domain": {"$ref": "#/$defs/identifier"},
        "capability": {"$ref": "#/$defs/identifier"},
        "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}}
      }
    }
  }
}
